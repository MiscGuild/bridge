{
    "compilerOptions": {
        "target": "ESNext",
        "module": "CommonJS",
        "moduleResolution": "Node",
        "baseUrl": "./src",
        "rootDir": "./src",
        "outDir": "./dist",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitReturns": true,
        "allowUnreachableCode": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "paths": {
            "@/*": ["./*"]
        }
    },
    "include": ["src/**/*"]
}
