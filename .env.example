# Miscellaneous Guild Bridge — configuration
#
# Copy this file to .env and fill in the values marked REQUIRED.
# Everything else is optional: the commented-out value is the default.

# ── Minecraft ────────────────────────────────────────────────────────
# REQUIRED. Microsoft account; the first start prints a sign-in link in the console.
MINECRAFT_EMAIL=your-minecraft-email@example.com

# Goes between a Discord name and its message in-game, e.g. "Steve » hello"
# MINECRAFT_CHAT_SEPARATOR=»
# Seconds to wait before reconnecting after a disconnect
# MINECRAFT_RECONNECT_DELAY=10

# ── Limbo keep-alive ─────────────────────────────────────────────────
# The bot idles in Hypixel's Limbo. If it lands anywhere else it retries /limbo,
# relogs after too many failures, and exits after too many failed sessions in a row.
# MINECRAFT_LIMBO_RETRY_COOLDOWN_SECONDS=15
# MINECRAFT_LIMBO_MAX_ATTEMPTS=5
# MINECRAFT_LIMBO_EXIT_AFTER_SESSIONS=3
# Connected but outside Limbo this long → the health monitor relogs
# MINECRAFT_LIMBO_CONNECTED_GRACE_SECONDS=90

# ── Health relogin ───────────────────────────────────────────────────
# Relogs the bot when it stays disconnected or out of Limbo.
# MINECRAFT_HEALTH_RELOGIN_ENABLED=true
# Minutes unhealthy before a relogin, and minimum minutes between relogins
# MINECRAFT_HEALTH_RELOGIN_GRACE_MINUTES=2
# MINECRAFT_HEALTH_RELOGIN_COOLDOWN_MINUTES=5
# Stop after this many relogins, until the bot has been healthy for RESET_MINUTES
# MINECRAFT_HEALTH_RELOGIN_MAX_ATTEMPTS=5
# MINECRAFT_HEALTH_RELOGIN_RESET_MINUTES=30

# ── Hypixel ──────────────────────────────────────────────────────────
# REQUIRED
HYPIXEL_API_KEY=your-hypixel-api-key
HYPIXEL_GUILD_NAME=YourGuildName

# A second key, used in turn with the first to spread out rate limits
# FALLBACK_HYPIXEL_API_KEY=

# ── Discord ──────────────────────────────────────────────────────────
# REQUIRED
DISCORD_TOKEN=your-discord-bot-token
# Included in the kick message blacklisted players see
DISCORD_INVITE_LINK=discord.gg/yourinvite
# Bridged to guild chat
MEMBER_CHANNEL_ID=123456789012345678
# Bridged to officer chat
OFFICER_CHANNEL_ID=123456789012345678
# Where blacklist additions, removals and expiries are logged
BLACKLIST_CHANNEL_ID=123456789012345678
# Can use the staff slash commands
STAFF_ROLE_ID=123456789012345678
# Your Discord user ID — always counts as staff
BOT_OWNER_ID=123456789012345678

# Discord messages starting with this aren't sent to Minecraft
# DISCORD_IGNORE_PREFIX=!

# ── Bridge access (Discord roles) ────────────────────────────────────
# Members with this role can't send messages to Minecraft (given by !bridge-mute and /bridge mute)
# BRIDGE_MUTED_ROLE_ID=
# Comma-separated. When set, only these roles (plus staff and BRIDGE_ACCESS_ROLE_ID) can use the bridge;
# when empty, anyone who can see the bridge channels can.
# GUILD_MEMBER_ROLE_IDS=
# Lets people outside the guild use the bridge
# BRIDGE_ACCESS_ROLE_ID=

# ── Discord → Minecraft messages ─────────────────────────────────────
# Block messages with profanity (and alert officer chat)
# USE_PROFANITY_FILTER=true
# Use only the first word of a Discord display name in-game
# USE_FIRST_WORD_OF_AUTHOR_NAME=false

# ── Reminders ────────────────────────────────────────────────────────
# Sends REMINDER_MESSAGE (max 256 characters) to guild chat every REMINDER_FREQUENCY minutes
# REMINDER_ENABLED=false
# REMINDER_MESSAGE=
# REMINDER_FREQUENCY=60

# ── Blacklist & Coral ────────────────────────────────────────────────
# Coral (api.urchin.gg) API key — needed for !view, /blacklist check and join checks
# URCHIN_API_KEY=
# Report Coral tags in officer chat when someone joins the guild
# URCHIN_JOIN_CHECK=false
# Show "Miscellaneous Staff" instead of the moderator's name in blacklist embeds
# BLACKLIST_ANONYMOUS=false
# Added to a temporary blacklist when the player gets back into the guild
# BLACKLIST_REJOIN_EXTENSION_MONTHS=2
# How often to scan the guild for blacklisted members, and to lift expired entries
# BLACKLIST_GUILD_SCAN_INTERVAL_MINUTES=5
# BLACKLIST_EXPIRY_CHECK_INTERVAL_MINUTES=5

# ── Staff & cooldowns ────────────────────────────────────────────────
# Guild ranks are split into tiers 1 (lowest) to 5 (highest below Guild Master).
# In-game staff commands work from this tier up; the Guild Master always counts as staff.
# STAFF_MIN_RANK=4
# In-game command cooldown in seconds for each tier (0 = no cooldown)
# COOLDOWN_RANK_1=60
# COOLDOWN_RANK_2=20
# COOLDOWN_RANK_3=15
# COOLDOWN_RANK_4=12
# COOLDOWN_RANK_5=10
# COOLDOWN_LEADER=0

# ── Rank fallbacks ───────────────────────────────────────────────────
# Rank names and tags are normally read from the Hypixel API. These are used if it can't be reached.
# RANK_1_NAME=
# RANK_1_TAG=
# RANK_2_NAME=
# RANK_2_TAG=
# RANK_3_NAME=
# RANK_3_TAG=
# RANK_4_NAME=
# RANK_4_TAG=
# RANK_5_NAME=
# RANK_5_TAG=
# RANK_LEADER_TAG=GM

# ── Terminal ─────────────────────────────────────────────────────────
# Interactive console (/gc, /oc, /cmd, /online, /status, /reconnect, /stop)
# ENABLE_TERMINAL=false
# Send plain console lines straight to guild chat
# ENABLE_TERMINAL_CHAT=false
