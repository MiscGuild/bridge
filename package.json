{
    "name": "miscellaneous-bridge-v3",
    "version": "3.0.0-alpha",
    "description": "A bot used to Bridge between Discord and Hypixel guild chats",
    "main": "dist/index.js",
    "scripts": {
        "start": "node dist/index.js",
        "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc && tsc-alias",
        "lint": "eslint src/",
        "format": "prettier --write ."
    },
    "keywords": [
        "minecraft",
        "discord",
        "hypixel",
        "guild",
        "bridge",
        "bot",
        "mineflayer"
    ],
    "author": "Vliegenier04",
    "license": "MIT",
    "dependencies": {
        "consola": "^3.4.2",
        "discord.js": "^14.22.1",
        "dotenv": "^17.2.2",
        "mineflayer": "^4.32.0",
        "node-cache": "^5.1.2",
        "obscenity": "^0.4.5",
        "skyhelper-networth": "^2.7.2",
        "zod": "^3.22.4"
    },
    "overrides": {
        "axios": "^1.15.0",
        "minimatch": "^9.0.7"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/node": "^20.10.0",
        "eslint": "^9.39.4",
        "prettier": "^3.0.0",
        "tsc-alias": "^1.8.16",
        "typescript": "^5.3.0",
        "typescript-eslint": "^8.58.2"
    }
}
